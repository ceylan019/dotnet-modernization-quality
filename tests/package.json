{
  "name": "permits-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:legacy:reset": "tsx --env-file-if-exists=../.env src/db/reset-legacy-db.ts",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "mssql": "12.7.10"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/mssql": "12.3.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
