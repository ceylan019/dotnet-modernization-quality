{
  "name": "permits-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "db:legacy:reset": "tsx --env-file-if-exists=../.env src/db/reset-legacy-db.ts",
    "test:unit": "vitest run unit/",
    "test:db": "vitest run db/",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:parity": "playwright test --grep @parity",
    "test:mutation": "stryker run",
    "gate": "tsx src/gate/gate-cli.ts",
    "seed:small": "tsx src/seed/generate.ts --size small --out seed-data",
    "seed:large": "tsx src/seed/generate.ts --size large --out reports/seed-large",
    "perf": "k6 run perf/journeys.js",
    "perf:evidence": "tsx src/gate/k6-evidence.ts",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 collect --config=lighthouse/lighthouserc.cjs",
    "lighthouse:summarize": "tsx src/gate/lighthouse-evidence.ts summarize",
    "lighthouse:evidence": "tsx src/gate/lighthouse-evidence.ts evidence",
    "baselines:compare": "tsx src/parity/compare-baseline-dirs.ts",
    "bruno": "npx --yes @usebruno/cli@3.0.3 run --env legacy",
    "risks:md": "tsx src/gate/risk-register-md.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@faker-js/faker": "10.6.0",
    "graphql": "16.14.2",
    "mssql": "12.7.10",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/mssql": "12.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "allure-playwright": "3.14.0",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
